#
# DeshabOS Installer — minimal Linux 6.6 (x86_64)
#
# 用途：INSTALL/deshab-installer.iso 的内核。启动后由 busybox initramfs
#       组网、从 GitHub Releases 拉取 deshab-release.img.gz 分卷并 dd 到目标盘。
#
# 原则：
#   - 单文件内置（无模块），initramfs 里不加载任何 .ko
#   - 控制台双路：VGA/EFI framebuffer (tty0) + 串口 (ttyS0)
#   - 仅有线网卡（WiFi 需要 firmware blob，超出“最简内核”范围）
#   - 目标盘：NVMe / SATA(AHCI) / USB
#   - 无 DRM / 无显示服务 / 无文件系统写支持（dd 直接写裸盘，不需要 fs 驱动）
#
# 构建：make O=<out> installer_defconfig && make O=<out> -j$(nproc) bzImage
#       （INSTALL/build_installer.sh 会把它复制到源码树 arch/x86/configs/）

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_OUTPUT_FORMAT="elf64-x86-64"
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_X86_64_SMP=y
CONFIG_MK8=y
CONFIG_X86_CPU=y
CONFIG_X86_TSC=y
CONFIG_X86_CMPXCHG64=y
CONFIG_X86_CMOV=y
CONFIG_X86_MINIMUM_CPU_FAMILY=64
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_CPU_SUP_CENTAUR=y
CONFIG_HPET_TIMER=y
CONFIG_HPET_EMULATE_RTC=y
CONFIG_DMI=y

# Memory
CONFIG_PHYS_ADDR_T_64BIT=y
CONFIG_ARCH_PHYS_ADDR_T_64BIT=y
CONFIG_ARCH_DMA_ADDR_T_64BIT=y
CONFIG_DIRECT_GBPAGES=y
CONFIG_ARCH_SPARSEMEM_ENABLE=y
CONFIG_ARCH_SPARSEMEM_DEFAULT=y
CONFIG_ILLEGAL_POINTER_VALUE=0xdead000000000000
CONFIG_MTRR=y
CONFIG_X86_PAT=y

# Bus
CONFIG_PCI=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_DOMAINS=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MSI_IRQ_DOMAIN=y

# Executable formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Networking (busybox udhcpc / wget)
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_INET_DIAG=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_SYN_COOKIES=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=y

# 有线网卡（QEMU / VirtualBox / 常见板载）
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_IGB=y
CONFIG_8139TOO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# Console：VGA 文本 + EFI framebuffer + 串口
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_EARLY_PRINTK=y
CONFIG_EARLY_PRINTK_SERIAL=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# EFI（UEFI 引导时取 GOP framebuffer；BIOS 引导时用 VGA 文本）
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y

# 键盘（交互选择目标盘）
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_KBD=y
CONFIG_INPUT_MISC=y

# USB 栈（USB 键盘 / U 盘目标盘）
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y

# 目标盘：NVMe / SATA
CONFIG_BLK_DEV=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_VERBOSE_ERROR=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y

# 伪文件系统
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# initramfs（外部 gzip cpio）
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""

# 内核日志
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=4
CONFIG_MAGIC_SYSRQ=y

# 压缩库（initrd gzip 解压）
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y

# 无模块（全部内置）
# CONFIG_MODULES is not set

# UTSM hcall 驱动默认 y，但安装器跑在裸机/UEFI 上（没有 UTSM hypervisor），
# 初始化会执行 VMCALL 触发 #UD → kernel panic。必须显式关闭。
# CONFIG_UTSM_HCALL is not set
# CONFIG_UTSM_EARLY_CONSOLE is not set
