# Deshab Kernel Configuration — dev 变体（build/configs/dev/FUCK）
# build.ps1 -Variant dev 打包前注入 SYSTEM/system/deshab64/FUCK
# 开发者模式：selftest 开、dev_mode 自动跑 shell.elf 测试、日志持久化、跳过向导直达桌面

[boot]
vmm=1
linux_guest=1
windows_guest=0
windows_autostart=0
xj380_guest=0
# F4: 分级自检 0=关 1=快速 2=全量（含 UTSM selftest；RFC 8439 KAT 已确定性对拍通过）
selftest=1
# F1 验证钩子: 1=启动自检后触发莲花崩溃屏（演示/回归用，日常保持 0）
panic_test=0
dev_mode=0
la57_guard=0
mcfg_check=0
max_phys_addr_bits=0
# GOP 分辨率（0=自动）。引导器只选显存需求 ≤8MiB 的模式（桌面双缓冲上限），
# 自动优先级 1280x800 > 1280x720 > 1366x768 > 1600x900 > 1600x1200 > 1024x768。
# 需要固定分辨率时填 gop_width/gop_height（两个都要非 0 才生效）。
gop_width=0
gop_height=0
disk_log=1

[drivers]
timer=1
apic=1
acpi=1
pci=1
console_fb=1
ahci=1
nvme=1
ehci=1
xhci=1
bootfs=1
vfs=1
fat32=1
devfs=1
e1000=1
virtio_net=1
ath9k=0
mt7920=1
ps2kbd=1
ioapic_init=1
lapic_enable=1
apic_route=1
apic_route_legacy=1
nvme_msi=1
apic_diag=0
# Intel HDA 音频（srv.audio.play/stop/info）；无控制器时静默就绪
hda=1
# hda_selftest=1：init 末尾播 440Hz 0.25s 并打印 rc（无音频环境可用串口判定）
hda_selftest=0

[utsm]
max_segments=1024
max_capabilities=256
max_pckc_keys=8
dirty_shard_pages=1024
arena_size_mb=64
drr_emergency_pool_kb=64
drr_recovery_log_size=4096
drr_heartbeat_interval=0

[sched]
enable=1
tick_hz=100
timeslice_ms=10
demo_ms=1000
demo_fault=0

[drr]
watchdog_enabled=1

# === panic 策略 ===
# mode=strict   ：未实现/异常一律 panic（莲花屏停机），STUB 规约默认行为。
# mode=fallback ：panic 点只记串口坐标 [PANIC:FALLBACK] 后走备用路径继续启动
#                 （跳过该能力/驱动/页面）；CPU 异常、LA57、DSK 跳转失败仍停机。
# 非 fallback 的任何值均按 strict 处理。
[panic]
# dev：启用 panic（strict），零降级
mode=strict

# === SAS-R0 启动期能力证明（attest） ===
# require_<name>=1（默认）而能力未就绪 → 启动即莲花屏 panic。
# require_<name>=0 是设计内白名单：仅限"该构建环境不可能具备"或
# "该能力尚未实现且已登记 STATUS.md ⬜/🔶"的项，须在 CLAUDE.md §3 说明。
[attest]
require_sealed_mem=1
require_pckc_derive=1
require_sched=1
require_drr=1
require_fs_fat32_rw=1
require_fs_ext4_rw=1
require_net_wired=1
# QEMU 无 wlan 硬件（ath9k=0），wlan 栈未实现（NET-E01）
require_net_wlan=0
# WHPX/TCG 无嵌套 VMX，QEMU 必无
require_vmm_vmx=0
# DRR 真 MAC = Phase 9（当前 CRC64 占位，DRR-E31）
require_drr_real_mac=0
# 以下为设计已定未实现（STATUS.md ⬜），实现后翻转 require=1
require_pkg=0
require_brand_anim=0
require_dkm_hot_unload=0
require_dkm_api_export=0
require_nvme_rw=0
require_virtio_net=0

[dsk]
show_logo=1
skip_login=0
# F5: dev 直达桌面（跳过向导与登录）；skip_firstinit=0 恢复完整流程
skip_firstinit=1
mouse_init=1
netman=1
session=native

# 桌面串口键鼠（!M/!C/!R/!K/!T）。与 [boot] dev_mode 分开：
# dev_mode=1 会先跑 shell 自测；单击复现只需要这条，不必打开 shell。
[desktop]
serial_test=1
motion_selftest=1

# === "极差用户体验" 整蛊系统 ===
# enable=1 打开总开关；下列各项 =0 可单独关闭。
# 触发：开机进桌面后 boot_demo_sec 秒串烧演示 + 使用中每 interval_sec 秒随机一个。
[prank]
enable=1
# 进桌面后串烧演示秒数（用于验证效果），0=关
boot_demo_sec=5
# 使用中自动整蛊间隔（秒），0=关
interval_sec=60
# 假蓝屏（Win 风格）
fake_bsod=1
# 全屏反色闪烁
invert_flash=1
# 假"程序未响应"对话框
fake_hang=1
# 打字乱码（按键被随机重映射）
garble_typing=1
# 任务栏图标乱飞
taskbar_fly=1
# 假"系统即将关机"倒计时
fake_shutdown=1

[debug]
enabled=1
log_level=1
probe_enable=1
probe_capacity=4096
stat_summary_interval=256
utsm_trace=1
vmm_trace=1
dkm_trace=1
dsk_trace=1
block_trace=1
net_trace=0
input_trace=1
color_log=1

[compat]
lib_path=lib
linux_lib_guest_path=/usr/lib/deshab
linux_lib_sync=0
vscode_install=0
pe_dll_search=1

[zts]
# ZTS 热更新子系统（srv.zts.*；模块仓库 SYSTEM/zts → ESP /zts）
enable=1
autoload=1
require_signature=0
selftest=1

[zt5]
# ZT5 作为 UTSM VMX guest 子系统；运行需要 nested VMX（WSL2+KVM）。
# enable 由 P3 阶段接通后改为 1。
enable=0
mode=headless
ram_mb=512
